# Browser-facing API origin. Safe to expose; this is not a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated origins allowed by FastAPI.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100,http://localhost:3102,http://127.0.0.1:3102

# Optional future provider key. The offline pipeline does not require it.
# OPENAI_API_KEY=
